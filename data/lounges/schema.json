{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rephase airport lounge research, version 1",
  "description": "One airport per file. Rules are OR alternatives; populated conditions within one rule are AND. Reviewed records require access-policy sources. Unknown facts must remain unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "airport", "timeZone", "updatedAt", "lounges"],
  "properties": {
    "$schema": { "type": "string", "const": "./schema.json" },
    "schemaVersion": { "const": 1 },
    "airport": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "timeZone": { "type": "string", "minLength": 1, "maxLength": 80 },
    "updatedAt": { "$ref": "#/definitions/date" },
    "lounges": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/definitions/lounge" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
    "text": { "type": "string", "pattern": "\\S", "maxLength": 2000 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2000 },
    "clock": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
    "closingClock": { "type": "string", "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$" },
    "amenity": { "enum": ["yes", "no", "unknown"] },
    "membership": { "enum": ["priority-pass","qantas-gold","qantas-platinum","qantas-platinum-one","qantas-club","oneworld-sapphire","oneworld-emerald","star-gold","united-club","alaska-lounge-plus","admirals-club","skyteam-elite-plus","oneworld-ruby","star-silver","skyteam-elite","qantas-bronze","qantas-silver","united-member","united-premier-silver","united-premier-gold","united-premier-platinum","united-premier-1k","american-member","american-gold","american-platinum","american-platinum-pro","american-executive-platinum","atmos-member","atmos-silver","atmos-gold","atmos-platinum","atmos-titanium","delta-member","delta-silver-medallion","delta-gold-medallion","delta-platinum-medallion","delta-diamond-medallion","british-airways-blue","british-airways-bronze","british-airways-silver","british-airways-gold","cathay-green","cathay-silver","cathay-gold","cathay-diamond","aeroplan-member","aeroplan-25k","aeroplan-35k","aeroplan-50k","aeroplan-75k","aeroplan-super-elite","krisflyer-member","krisflyer-elite-silver","krisflyer-elite-gold","emirates-blue","emirates-silver","emirates-gold","emirates-platinum","velocity-red","velocity-silver","velocity-gold","velocity-platinum","velocity-platinum-plus","koru-bronze","koru-silver","koru-gold","koru-platinum","koru-black","miles-and-more-member","miles-and-more-frequent-traveller","miles-and-more-senator","miles-and-more-hon-circle"] },
    "alliance": { "enum": ["oneworld", "star", "skyteam"] },
    "countries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "carriers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9]{2,3}$" } },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "checkedOn"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "title": { "$ref": "#/definitions/text" },
        "url": { "$ref": "#/definitions/url" }, "checkedOn": { "$ref": "#/definitions/date" }
      }
    },
    "photo": {
      "type": "object", "additionalProperties": false,
      "description": "Publish only owner-supplied or licensed images, with public credit and license evidence. Empty photo lists are valid.",
      "required": ["path", "alt", "credit", "license", "sourceUrl"],
      "properties": {
        "path": { "type": "string", "pattern": "^/lounges/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9][a-z0-9._-]*\\.(?:webp|avif|jpe?g|png)$", "maxLength": 250 },
        "alt": { "$ref": "#/definitions/text" }, "credit": { "$ref": "#/definitions/text" },
        "license": { "$ref": "#/definitions/text" }, "sourceUrl": { "$ref": "#/definitions/url" }
      }
    },
    "clockPeriod": {
      "type": "object", "additionalProperties": false, "required": ["open", "close"],
      "properties": { "open": { "$ref": "#/definitions/clock" }, "close": { "$ref": "#/definitions/closingClock" } }
    },
    "weeklyPeriod": {
      "type": "object", "additionalProperties": false, "required": ["days", "open", "close"],
      "properties": {
        "days": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 7 } },
        "open": { "$ref": "#/definitions/clock" }, "close": { "$ref": "#/definitions/closingClock" }
      }
    },
    "hours": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["weekly", "flight-dependent", "unknown"] },
        "periods": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/definitions/weeklyPeriod" } },
        "note": { "$ref": "#/definitions/text" },
        "exceptions": {
          "type": "array", "maxItems": 366,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["date", "periods"],
            "properties": {
              "date": { "$ref": "#/definitions/date" },
              "periods": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/clockPeriod" } },
              "note": { "$ref": "#/definitions/text" }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "weekly" } } }, "then": { "required": ["periods"] } },
        { "if": { "properties": { "type": { "enum": ["flight-dependent", "unknown"] } } }, "then": { "required": ["note"], "not": { "required": ["periods"] } } }
      ]
    },
    "accessRule": {
      "type": "object", "additionalProperties": false,
      "description": "At least one explicit membership, cabin or airline predicate is required. Material restrictions that cannot be encoded belong in conditions, not note.",
      "required": ["id", "label", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "label": { "$ref": "#/definitions/text" },
        "membershipsAnyOf": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/membership" } },
        "cabinsAnyOf": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["economy", "premium-economy", "business", "first"] } },
        "operatingCarriersAnyOf": { "$ref": "#/definitions/carriers" }, "marketingCarriersAnyOf": { "$ref": "#/definitions/carriers" },
        "operatingAlliance": { "$ref": "#/definitions/alliance" }, "marketingAlliance": { "$ref": "#/definitions/alliance" },
        "route": { "enum": ["domestic", "international"] },
        "destinationCountriesAnyOf": { "$ref": "#/definitions/countries" }, "excludedDestinationCountries": { "$ref": "#/definitions/countries" },
        "maxMinutesBeforeDeparture": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "minMinutesBeforeDeparture": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "maxVisitMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "additionalFee": {
          "type": "object", "additionalProperties": false, "required": ["amount", "currency"],
          "description": "A mandatory extra entry fee for this access route. Optional shower, dining or spa charges belong in the lounge notes.",
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        },
        "conditions": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/definitions/text" } },
        "note": { "$ref": "#/definitions/text" },
        "sourceIds": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } }
      },
      "anyOf": [
        { "required": ["membershipsAnyOf"] }, { "required": ["cabinsAnyOf"] },
        { "required": ["operatingCarriersAnyOf"] }, { "required": ["marketingCarriersAnyOf"] },
        { "required": ["operatingAlliance"] }, { "required": ["marketingAlliance"] }
      ]
    },
    "lounge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "terminal", "location", "airside", "status", "hours", "amenities", "accessRules", "sources", "photos"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "name": { "$ref": "#/definitions/text" },
        "terminal": { "$ref": "#/definitions/text" }, "location": { "$ref": "#/definitions/text" },
        "airside": { "type": "boolean" }, "status": { "enum": ["open", "temporarily-closed"] },
        "hours": { "$ref": "#/definitions/hours" },
        "amenities": {
          "type": "object", "additionalProperties": false, "required": ["showers", "dining", "spa", "quietArea", "wifi"],
          "properties": {
            "showers": { "$ref": "#/definitions/amenity" }, "spa": { "$ref": "#/definitions/amenity" },
            "quietArea": { "$ref": "#/definitions/amenity" }, "wifi": { "$ref": "#/definitions/amenity" },
            "dining": { "enum": ["restaurant", "buffet", "snacks", "none", "unknown"] }
          }
        },
        "accessRules": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/definitions/accessRule" } },
        "sources": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/definitions/source" } },
        "photos": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/photo" } },
        "recommendation": {
          "type": "object", "additionalProperties": false, "required": ["summary"],
          "description": "A concise practical summary from cited research, with optional amenity priorities. Do not invent ratings or claim a personal visit.",
          "properties": {
            "summary": { "type": "string", "pattern": "\\S", "maxLength": 500 },
            "bestFor": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["balanced", "showers", "dining", "quiet"] } }
          }
        },
        "note": { "$ref": "#/definitions/text" }
      }
    }
  }
}
