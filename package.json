{
  "name": "rephase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mobile": "node scripts/mobile.mjs",
    "mobile:engine": "node scripts/build-mobile-engine.mjs",
    "mobile:check": "node scripts/mobile.mjs check",
    "mobile:apk": "node scripts/mobile.mjs apk",
    "start": "node scripts/launch.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply rephase --local",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/check-deploy-config.mjs",
    "cloudflare:configure": "node scripts/configure-cloudflare.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"worker/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"worker/**/*.ts\""
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "idb": "^8.0.3",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "miniflare": "5.20261012.0-beta",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
