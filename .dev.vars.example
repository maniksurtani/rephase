# Copy to .dev.vars for local Worker development; do not commit .dev.vars.
# Register http://localhost:5173 as an authorized JavaScript origin in a
# Google OAuth Web application client. The public client ID is required.
GOOGLE_CLIENT_ID=""
ALLOWED_ORIGIN="http://localhost:5173"
# Optional AeroDataBox RapidAPI key. This is a secret; keep it in this ignored local file.
RAPIDAPI_KEY=""
